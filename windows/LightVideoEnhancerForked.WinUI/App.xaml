<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LightVideoEnhancerForked_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LightVideoEnhancerForked_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <!--
                CompactNumberBoxStyle must NOT use BasedOn="{StaticResource
                DefaultNumberBoxStyle}": WinUI 3 has no keyed default NumberBox
                style (that pattern exists only in WinUI 2 / UWP). The reference
                throws XamlParseException 0x802B000A ("Cannot find a Resource
                with the Name/Key DefaultNumberBoxStyle") as soon as a NumberBox
                applies the style, which fail-fasts the app during OnLaunched.
                A keyed style without BasedOn is applied on top of the control's
                implicit default style, so the NumberBox keeps its template.
            -->
            <Style x:Key="CompactNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="80" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
